{
  "compilerOptions": {
    // Environment & Module Settings for Node.js ESM
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // Outputs & Paths
    "outDir": "./dist",
    "rootDir": "./src",

    // Custom Type Resolution
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ],

    // Build Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Typechecking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ]
}